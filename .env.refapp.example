# Reference application configuration (local test fixture; loopback binding enforced).
# Copy to .env.refapp and replace every placeholder.
#
# Kept separate from .env deliberately: each settings class uses extra="forbid" so a typo in a
# variable name fails startup instead of silently leaving a default in place. A single shared file
# would make every other prefix look like an unknown key.

# --- reference application (local test fixture; loopback only) ------------------------
REFAPP_DATABASE_URL=postgresql://accessforge:REPLACE_ME@localhost:5432/accessforge_refapp
REFAPP_HOST=127.0.0.1
REFAPP_PORT=8081
REFAPP_ENVIRONMENT=local
# Test-only identities, minimum 16 characters. Generate with: openssl rand -hex 24
# The navigator must never receive REFAPP_OBSERVER_TOKEN — it is the observer's answer key.
REFAPP_OBSERVER_TOKEN=REPLACE_ME_WITH_A_RANDOM_VALUE
REFAPP_SETUP_TOKEN=REPLACE_ME_WITH_A_RANDOM_VALUE
