# Object-store configuration for the evidence-artifact suite. Copy to .env.objectstore.
#
# A real S3-compatible endpoint is required. There is no filesystem fallback: a stand-in would pass
# every assertion in tests/integration/test_evidence_artifacts.py while proving none of them, and
# SESSION-HEADER section 12 forbids presenting one as object-store success.
#
# Locally: `colima start` then a MinIO container. See docs/development/VERIFICATION.md.
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_ACCESS_KEY=REPLACE_ME_WITH_A_RANDOM_VALUE
OBJECT_STORE_SECRET_KEY=REPLACE_ME_WITH_A_RANDOM_VALUE
OBJECT_STORE_BUCKET=accessforge-evidence
