{
  "$comment": "Shared RFC8785 (JCS) canonicalization vectors. Python and TypeScript must produce byte-identical canonical output and identical lower-case SHA-256 digests for every case. Consumed by tests in both languages; neither language owns these.",
  "cases": [
    {
      "name": "empty-object",
      "input": {},
      "canonical": "{}"
    },
    {
      "name": "property-order-is-by-utf16-code-unit",
      "input": {
        "b": 1,
        "a": 2,
        "C": 3,
        "ä": 4,
        "A": 5
      },
      "canonical": "{\"A\":5,\"C\":3,\"a\":2,\"b\":1,\"ä\":4}"
    },
    {
      "name": "nested-objects-sort-independently",
      "input": {
        "z": {
          "y": 1,
          "x": 2
        },
        "a": {
          "b": 3
        }
      },
      "canonical": "{\"a\":{\"b\":3},\"z\":{\"x\":2,\"y\":1}}"
    },
    {
      "name": "arrays-preserve-order",
      "input": {
        "k": [
          3,
          1,
          2
        ]
      },
      "canonical": "{\"k\":[3,1,2]}"
    },
    {
      "name": "integers",
      "input": {
        "zero": 0,
