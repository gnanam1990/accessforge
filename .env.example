# AccessForge control-plane configuration.
# Copy to .env and replace every placeholder. Startup fails closed on placeholder values.
# The reference application has its own file: .env.refapp.example
# Never commit a filled-in .env.

ACCESSFORGE_DATABASE_URL=postgresql://accessforge:REPLACE_ME@localhost:5432/accessforge
ACCESSFORGE_EVIDENCE_ENDPOINT_URL=http://localhost:9000
ACCESSFORGE_EVIDENCE_BUCKET=accessforge-evidence-local
ACCESSFORGE_EVIDENCE_ACCESS_KEY=REPLACE_ME
ACCESSFORGE_EVIDENCE_SECRET_KEY=REPLACE_ME
ACCESSFORGE_ENVIRONMENT=local
ACCESSFORGE_HOST=127.0.0.1
ACCESSFORGE_PORT=8080

# Who establishes that a person is who they say they are.
#
#   none               (default) This deployment cannot sign anyone in. POST /v1/sessions answers
#                      503 and names the missing dependency, and the web UI shows that instead of a
#                      login form nobody could use.
#   local-development  Accepts an email address with NO SECRET and issues a session for a matching
#                      enabled account. That is an authentication bypass by construction. It exists
#                      so a developer can operate the product on their own machine, and startup
#                      refuses it unless ACCESSFORGE_ENVIRONMENT is `local` — setting the variable
#                      is not enough. Never set it anywhere a person other than you can reach.
ACCESSFORGE_IDENTITY_PROVIDER=none
