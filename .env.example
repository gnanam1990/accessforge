# AccessForge control-plane configuration.
# Copy to .env and replace every placeholder. Startup fails closed on placeholder values.
# The reference application has its own file: .env.refapp.example
# Never commit a filled-in .env.

ACCESSFORGE_DATABASE_URL=postgresql://accessforge:REPLACE_ME@localhost:5432/accessforge
ACCESSFORGE_EVIDENCE_ENDPOINT_URL=http://localhost:9000
ACCESSFORGE_EVIDENCE_BUCKET=accessforge-evidence-local
ACCESSFORGE_EVIDENCE_ACCESS_KEY=REPLACE_ME
ACCESSFORGE_EVIDENCE_SECRET_KEY=REPLACE_ME
ACCESSFORGE_ENVIRONMENT=local
ACCESSFORGE_HOST=127.0.0.1
ACCESSFORGE_PORT=8080
