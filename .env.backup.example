# Backup and restore configuration (scripts/backup.py, scripts/restore.py).
#
# A SEPARATE file, and not part of .env, for a reason that cost a startup failure to find: the
# control plane's settings use env_prefix "ACCESSFORGE_" with extra="forbid", so any
# ACCESSFORGE_-prefixed name in .env that the API does not define makes the API refuse to start.
# These variables belong to the backup operator, who is a different person on a different machine
# from the one serving traffic -- so they live where that person keeps them.
#
# Copy to .env.backup and fill in. Never commit a filled-in copy.

# The role a backup connects as MUST bypass row-level security. FORCE ROW LEVEL SECURITY applies to
# the table owner, so the application role cannot pg_dump its own rows: it produces a structurally
# valid dump containing none of its data, and nobody notices until a restore.
ACCESSFORGE_BACKUP_DATABASE_URL=postgresql://backup-role:REPLACE_ME@localhost:5432/accessforge

# 32 raw bytes, base64-encoded. Create with:
#   uv run python scripts/backup.py --write-new-key --key-file /secure/backup.key --output /dev/null
#
# Rotating this key does NOT re-encrypt existing archives. Every backup sealed with the old key
# needs the old key forever, or it is unreadable -- which is why --write-new-key refuses to
# overwrite an existing file. Keep retired keys for at least the backup retention period.
ACCESSFORGE_BACKUP_KEY_FILE=/secure/backup.key
ACCESSFORGE_BACKUP_KEY_ID=af-backup
