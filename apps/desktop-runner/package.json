{
  "name": "@accessforge/desktop-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "accessforge-runner": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @accessforge/contracts build && pnpm --filter @accessforge/at-voiceover build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@accessforge/at-voiceover": "workspace:*",
    "@accessforge/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.7.3"
  }
}
