# Dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.py[cod]

# Build output
dist/
*.tsbuildinfo
build/
.next/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
# Every *.example file is a committed template. Listing them individually meant a new one
# (.env.refapp.example, .env.test.example) was silently excluded from the commit.
!.env*.example
*.pem
*.key

# Private run evidence (never committed; see docs/development/VERIFICATION.md)
.evidence/

# Local databases and caches
*.sqlite
*.db
.cache/
coverage/

# OS
.DS_Store

# Written by scripts/audit_python_dependencies.py as the input it hands pip-audit. Derived from
# uv.lock on every run, so committing it would create a second source of truth that goes stale
# silently -- and a reviewer comparing the two would have no way to know which one the gate used.
locked-requirements.txt
