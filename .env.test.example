# Test-harness configuration. Copy to .env.test.
# Separate from .env and .env.refapp: each settings class uses extra="forbid", so a file must
# contain only the keys its consumer expects.
TEST_DATABASE_URL=postgresql://accessforge:REPLACE_ME@localhost:5432/accessforge_test

# A connection that can actually take a backup.
#
# Every tenant-owned table has FORCE ROW LEVEL SECURITY, which applies to the table owner too — so
# `pg_dump` run as the application role fails outright: it cannot read the rows it owns. A backup
# needs a role with BYPASSRLS, or a superuser. This is not a test detail: a backup script running as
# the application role produces no backup, and finds out at restore time.
#
# The restore drill fails rather than skips when this is absent.
BACKUP_DATABASE_URL=postgresql://REPLACE_ME_WITH_A_BYPASSRLS_ROLE@localhost:5432/accessforge_test
